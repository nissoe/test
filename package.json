{
  "name": "twinlock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TWINLOCK — a 3D twin-linked sliding puzzle",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --outDir docs --emptyOutDir",
    "preview": "vite preview --host",
    "gen": "tsx tools/generate.ts",
    "verify": "tsx tools/verify.ts",
    "test": "tsx tools/engine.test.ts && tsx tools/verify.ts",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
