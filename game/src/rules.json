{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && data.child('host').val() === auth.uid",
        ".validate": "$code.matches(/^[0-9]{4}$/)",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "created": {
          ".write": "auth != null && !data.exists() && newData.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "inputs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "daily": {
      "$date": {
        ".read": "auth != null",
        ".indexOn": [
          "score"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 60 && newData.child('name').isString() && newData.child('name').val().length <= 20"
        }
      }
    },
    "open": {
      ".read": "auth != null",
      "$size": {
        ".validate": "$size === '4' || $size === '6' || $size === '8'",
        "$code": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host','n','t']) && newData.child('n').isNumber()"
        }
      }
    }
  }
}